{
  "manifest_version": 3,
  "name": "Scholar Dashboard",
  "version": "1.0.0",
  "description": "Add papers to your Scholar Dashboard library from Google Scholar, Scholar alert emails and any paper's page.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add to your library",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:7823/*",
    "https://raw.githubusercontent.com/sumanth-tangirala/scholar-dashboard/*"
  ],
  "optional_host_permissions": [
    "https://*.ts.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/*",
        "https://scholar.google.co.uk/*",
        "https://scholar.google.ca/*",
        "https://scholar.google.de/*",
        "https://scholar.google.fr/*",
        "https://scholar.google.co.in/*",
        "https://scholar.google.com.au/*",
        "https://scholar.google.co.jp/*",
        "https://scholar.google.es/*",
        "https://scholar.google.it/*",
        "https://scholar.google.nl/*",
        "https://scholar.google.ch/*",
        "https://scholar.google.com.sg/*",
        "https://scholar.google.com.hk/*",
        "https://scholar.google.co.kr/*",
        "https://scholar.google.com.br/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "page.js"
      ],
      "css": [
        "page.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Add the paper on this page"
    }
  }
}
